# ═══════════════════════════════════════════════════════════════════
# MindCrew · 开发环境变量模板（docker-compose.yml 用）
# 用法：复制为 .env，按需修改，然后 docker compose up -d
#
# .env 已加入 .gitignore，本文件 .env.example 不含真实密钥可以提交
# ═══════════════════════════════════════════════════════════════════

# ── 必填 · 阿里云百炼 API Key ──
# 申请地址: https://bailian.console.aliyun.com/?apiKey=1
BAILIAN_API_KEY=

# ── 可选 · 联网搜索 ──
# 智能问答对话框里的「联网」开关要真正搜到东西，必须填对应搜索源的 Key。
# 留空 = 即使用户打开联网开关，AI 也拿不到任何网络结果（等于没开）。
# 联网搜索源：baidu(百度千帆 AI 搜索，默认) / tavily
WEB_SEARCH_PROVIDER=baidu
# 百度千帆 AI 搜索 Key（千帆平台 API Key，Bearer）: https://console.bce.baidu.com/qianfan/
BAIDU_SEARCH_API_KEY=
# Tavily（备用/回退）注册（免费 1000 次/月）: https://app.tavily.com  →  复制 tvly- 开头的 key
TAVILY_API_KEY=
# 联网总开关（默认 true）。设为 false 则全局禁用联网，对话框开关也不生效。
DOCMIND_WEB_SEARCH_ENABLED=true

# ── 端口（默认值如有冲突可改） ──
FRONTEND_PORT=80
BACKEND_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379
MILVUS_PORT=19530
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── 数据库 / 缓存默认凭证（开发环境可用默认） ──
MYSQL_ROOT_PASSWORD=root
REDIS_PASSWORD=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── 存储模式 ──
# minio  · 本地 MinIO（开发默认）
# oss    · 阿里云 OSS（需填下方 OSS_* 参数）
STORAGE_TYPE=minio

# ── 阿里云 OSS（STORAGE_TYPE=oss 时必填） ──
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing
OSS_BUCKET=mindcrew-prod
OSS_ACCESS_KEY=
OSS_SECRET_KEY=

# ── JVM 调优 ──
JAVA_OPTS=-Xms512m -Xmx2048m -XX:+UseG1GC

# ── 加密主密钥（生产必改 · 32 字符以上随机串） ──
CRYPTO_MASTER_KEY=please-change-me-in-production-32chars-min
