# ═══════════════════════════════════════════════════════════════════
# MindCrew · 自建服务器部署变量模板（自建 MySQL + 阿里云 OSS）
# 配 deploy.selfhost.sh + docker-compose.yml 使用
#
# 用法：cp .env.selfhost.example .env.selfhost，填好后 ./deploy.selfhost.sh init
# .env.selfhost 已被 .gitignore 忽略，本模板不含真实密钥可提交
# ═══════════════════════════════════════════════════════════════════

# ── 必填 · 阿里云百炼 API Key ──
# 申请: https://bailian.console.aliyun.com/
BAILIAN_API_KEY=

# ── 可选 · 联网搜索 ──
# 智能问答对话框里的「联网」开关要真正搜到东西，必须填对应搜索源的 Key。
# 留空 = 即使用户打开联网开关，AI 也拿不到任何网络结果（等于没开）。
# 联网搜索源：baidu(百度千帆 AI 搜索，默认) / tavily
WEB_SEARCH_PROVIDER=baidu
# 百度千帆 AI 搜索 Key（千帆平台 API Key，Bearer）: https://console.bce.baidu.com/qianfan/
BAIDU_SEARCH_API_KEY=
# Tavily（备用/回退）注册（免费 1000 次/月）: https://app.tavily.com  →  复制 tvly- 开头的 key
TAVILY_API_KEY=
# 联网总开关（默认 true）。设为 false 则全局禁用联网，对话框开关也不生效。
DOCMIND_WEB_SEARCH_ENABLED=true

# ── 构建加速（可选）──
# 默认使用腾讯云公网 Ubuntu 镜像；腾讯云 CVM 可改为内网地址：
# UBUNTU_MIRROR=http://mirrors.tencentyun.com/ubuntu
UBUNTU_MIRROR=https://mirrors.cloud.tencent.com/ubuntu

# ── 对象存储：用阿里云 OSS（不用本地 MinIO 存业务文件） ──
STORAGE_TYPE=oss

# ── 阿里云 OSS（STORAGE_TYPE=oss 时必填） ──
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY=
OSS_SECRET_KEY=

# ── 自建 MySQL（容器内，不依赖 RDS）· 强烈建议改成强密码 ──
MYSQL_ROOT_PASSWORD=change-this-strong-password

# ── Redis（容器内）· 留空=无密码 ──
REDIS_PASSWORD=

# ── 加密主密钥（必改 · 32 字符以上随机串） ──
# 生成: openssl rand -base64 32
CRYPTO_MASTER_KEY=please-change-me-to-a-random-32+chars-string

# ── JVM（按服务器内存调整） ──
JAVA_OPTS=-Xms512m -Xmx2048m -XX:+UseG1GC -Djava.awt.headless=true

# ── 端口（如与现有服务冲突可改） ──
FRONTEND_PORT=80

# 说明：
#   - Milvus 向量库仍依赖容器内 MinIO（给 Milvus 自己存数据），
#     这个 MinIO 用默认账号即可，与上面 STORAGE_TYPE=oss（业务文件存 OSS）互不影响。
