# ═══════════════════════════════════════════════════════════════════
# MindCrew · 阿里云生产环境变量模板（docker-compose.prod.yml 用）
# 用法：复制为 .env.prod，填实际值，然后:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# ═══════════════════════════════════════════════════════════════════

# ── 镜像 tag（CI 推送时按 commit hash 替换） ──
IMAGE_TAG=latest

# ─────────────────────────────────────────────
# 阿里云 RDS MySQL · 控制台 → RDS → 实例详情 → 内网地址
# ─────────────────────────────────────────────
MYSQL_HOST=rm-bp1xxxxxxxxxx.mysql.rds.aliyuncs.com
MYSQL_PORT=3306
MYSQL_USER=mindcrew                                # 建议 RDS 创建专用账号，别用 root
MYSQL_PASSWORD=CHANGE_ME_strong_password           # ≥ 16 位混合字符

# ─────────────────────────────────────────────
# 阿里云 Tair Redis · 控制台 → Tair → 实例详情 → 内网地址
# ─────────────────────────────────────────────
REDIS_HOST=r-bp1xxxxxxxxxx.redis.rds.aliyuncs.com
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# ─────────────────────────────────────────────
# 阿里云 OSS（必填 · 视频/音频 RAG 必需公网可达 URL）
# 控制台 → OSS → Bucket 详情 → 概览
# AccessKey 在 RAM 控制台子账号创建，授权 AliyunOSSFullAccess
# ─────────────────────────────────────────────
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com   # 与 Bucket 同地域
OSS_REGION=cn-beijing
OSS_BUCKET=mindcrew-prod
OSS_ACCESS_KEY=LTAI5xxxxxxxxxxxxxxxx
OSS_SECRET_KEY=CHANGE_ME_oss_secret
OSS_CUSTOM_DOMAIN=                                  # 可选 · CDN 加速域名

# ─────────────────────────────────────────────
# Milvus 内置 MinIO 凭证（Milvus 自己用的数据底座，与业务对象存储无关）
# ─────────────────────────────────────────────
MILVUS_MINIO_USER=mindcrew_milvus
MILVUS_MINIO_PASSWORD=CHANGE_ME_milvus_minio

# ─────────────────────────────────────────────
# 阿里云百炼 API Key
# https://bailian.console.aliyun.com
# ─────────────────────────────────────────────
BAILIAN_API_KEY=

# ─────────────────────────────────────────────
# 联网搜索（可选）
# 智能问答对话框里的「联网」开关要真正搜到东西，必须填对应搜索源的 Key。
# 留空 = 即使用户打开联网开关，AI 也拿不到任何网络结果（等于没开）。
# 联网搜索源：baidu(百度千帆 AI 搜索，默认) / tavily
# ─────────────────────────────────────────────
WEB_SEARCH_PROVIDER=baidu
# 百度千帆 AI 搜索 Key（千帆平台 API Key，Bearer）: https://console.bce.baidu.com/qianfan/
BAIDU_SEARCH_API_KEY=
# Tavily（备用/回退）注册（免费 1000 次/月）: https://app.tavily.com  →  复制 tvly- 开头的 key
TAVILY_API_KEY=
# 联网总开关（默认 true）。设为 false 则全局禁用联网，对话框开关也不生效。
DOCMIND_WEB_SEARCH_ENABLED=true

# ─────────────────────────────────────────────
# 加密主密钥（生产强制要求 · 32 字符以上随机串）
# 生成: openssl rand -base64 48
# ⚠ 上线后**绝不能改**，否则 LLM Provider 等加密配置全失效
# ─────────────────────────────────────────────
CRYPTO_MASTER_KEY=CHANGE_ME_at_least_32_chars_random_secret_xxxxxxxx

# JWT 签名密钥（用户 token 签名，可与 CRYPTO_MASTER_KEY 不同）
# 生成: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_jwt_secret_random_64_hex_chars

# ─────────────────────────────────────────────
# 阿里云账单对账（可选 · 定期拉真实账单，校准系统里估算的成本）
# 不配则自动跳过，不影响其它功能。注释务必单独占行，不要写在值后面！
# 需要一个 RAM 子账号 AK，授权 AliyunBSSReadOnlyAccess
# BSS_ENABLED=true 才启用定时对账（每天 3:30 拉前一天，阿里 T+1 出账）
# ─────────────────────────────────────────────
BSS_ENABLED=false
BSS_ACCESS_KEY=
BSS_SECRET_KEY=
# 需要对账的产品，逗号分隔。dashscope=百炼大模型，可加 oss
BSS_PRODUCT_CODES=dashscope
# 估算与真实差异超此比例写告警日志（0.10 = 10%）
BSS_ALERT_THRESHOLD=0.10

# ─────────────────────────────────────────────
# 语音播报情绪（可选）
# true 后会把音色/请求里的 emotion 注入 DashScope 合成请求。
# ⚠ 开启前请先用真实 Key 验证 cosyvoice-v2 是否接受 emotion 参数，否则可能合成失败。
# ─────────────────────────────────────────────
TTS_EMOTION_ENABLED=false

# ─────────────────────────────────────────────
# JVM 调优 · 4C8G ECS 推荐参数
# ─────────────────────────────────────────────
JAVA_OPTS=-Xms2g -Xmx5g -XX:+UseG1GC -XX:MaxRAMPercentage=70.0 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs/heap-dump.hprof
